# Optional Firebase Firestore service account JSON path.
# Keep this file out of source control.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json

# Optional: set to 1 to resume the latest paused/active session on backend launch.
POSE2PLAY_RESUME_LATEST=0

# Optional application metadata.
POSE2PLAY_APP_VERSION=0.1.0
